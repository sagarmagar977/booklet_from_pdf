---
import Layout from '../layouts/Layout.astro';
import BookletApp from '../components/BookletApp';
---

<Layout
  title="PDF 4-Page Signature Imposition - Prepress Utility"
  description="Impose your PDF document into standard 4-page signatures (1-sheet quires) online. Free client-side imposition with custom bleed and gutter controls."
  canonicalUrl="https://pdf-to-booklet.pages.dev/pdf-4-page-signature"
>
  <section class="seo-hero">
    <div class="container">
      <h1 class="page-title">PDF 4-Page <span class="gradient-text">Signature Imposition</span></h1>
      <p class="page-subtitle">
        Automatically partition and impose your PDFs into independent 4-page signatures for section-based book binding.
      </p>
    </div>
  </section>

  <!-- Interactive App React Island (Defaulted to signature imposition mode) -->
  <section class="app-section">
    <BookletApp client:load defaultPreset="auto" defaultMode="signature" />
  </section>

  <!-- Deep SEO Information Panel -->
  <section class="details-section">
    <div class="details-container">
      <h2>Understanding 4-Page Signatures</h2>
      <p>
        In bookbinding, a signature is a group of pages printed on a single sheet of paper, which is then folded and trimmed. A 4-page signature (also known as a 1-sheet quire) folds once down the middle to produce 4 pages.
      </p>
      
      <div class="details-grid">
        <div class="detail-card">
          <h3>The 4-Page Imposition Matrix</h3>
          <p>
            Each sheet $S_k$ has two sides. Side A (Front) places <strong>Page $4k + 4$</strong> on the left and <strong>Page $4k + 1$</strong> on the right. Side B (Back) places <strong>Page $4k + 2$</strong> on the left and <strong>Page $4k + 3$</strong> on the right. This layout ensures pages follow sequential reading order when folded individually and stacked.
          </p>
        </div>

        <div class="detail-card">
          <h3>Prepress Bleed & Margins</h3>
          <p>
            During physical trimming, blade shifts can crop text or create white border slivers. Our imposition engine supports outer bleed margin controls and center gutters in millimeters or points, giving you full prepress alignment flexibility.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .seo-hero {
    padding: 3rem 1.5rem 1rem 1.5rem;
    text-align: center;
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
  }

  .page-title {
    font-size: 2.75rem;
    font-weight: 800;
    margin-bottom: 1rem;
    line-height: 1.15;
  }

  .page-subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }

  .app-section {
    width: 100%;
    margin-bottom: 2rem;
  }

  .details-section {
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    padding: 4rem 1.5rem;
    width: 100%;
  }

  .details-container {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  .details-container h2 {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .details-container > p {
    color: var(--text-secondary);
    max-width: 800px;
    margin: 0 auto 3rem auto;
    font-size: 1.05rem;
  }

  .details-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    text-align: left;
  }

  .detail-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-color);
    padding: 2rem;
    border-radius: 12px;
  }

  .detail-card h3 {
    margin-bottom: 1rem;
    font-size: 1.25rem;
  }

  .detail-card p {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 2.25rem;
    }

    .details-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
