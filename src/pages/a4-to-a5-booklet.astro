---
import Layout from '../layouts/Layout.astro';
import BookletApp from '../components/BookletApp';
---

<Layout
  title="A4 to A5 PDF Booklet Converter - Free Online Utility"
  description="Impose standard A5 vertical PDF pages onto A4 landscape sheets to print a folded booklet. 100% private, client-side, instant Web Worker conversion."
  canonicalUrl="https://pdf-to-booklet.pages.dev/a4-to-a5-booklet"
>
  <section class="seo-hero">
    <div class="container">
      <h1 class="page-title">A4 to A5 <span class="gradient-text">Booklet Converter</span></h1>
      <p class="page-subtitle">
        Scale down and fit A5-sized PDF pages onto A4 paper in a 2-up layout to print A5 folded booklets. No server uploads.
      </p>
    </div>
  </section>

  <!-- Interactive App React Island (Defaulted to A4 target paper size preset) -->
  <section class="app-section">
    <BookletApp client:load defaultPreset="a4" defaultMode="signature" />
  </section>

  <!-- Deep SEO Information Panel -->
  <section class="details-section">
    <div class="details-container">
      <h2>Printing A5 Booklets on A4 Paper</h2>
      <p>
        An A4 sheet of paper is exactly twice the size of an A5 sheet. By folding an A4 landscape sheet in half, you create two vertical A5 pages. This makes A4 landscape the ideal medium for printing A5 booklets.
      </p>
      
      <div class="details-grid">
        <div class="detail-card">
          <h3>Proportional Aspect Ratio Scaling</h3>
          <p>
            When you select the <strong>A4 Landscape</strong> paper size preset with <strong>Fit to Half-Sheet</strong> scaling, our engine automatically scales your A5 input pages down proportionally to fit the A4 landscape divisions.
          </p>
        </div>

        <div class="detail-card">
          <h3>Custom Binding & Gutter Margins</h3>
          <p>
            Folders and binders need a center margin (gutter) to accommodate staples, rings, or glue without cutting into your content. Adjust the center gutter margin in the settings panel to guarantee clean margins for binding.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .seo-hero {
    padding: 3rem 1.5rem 1rem 1.5rem;
    text-align: center;
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
  }

  .page-title {
    font-size: 2.75rem;
    font-weight: 800;
    margin-bottom: 1rem;
    line-height: 1.15;
  }

  .page-subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }

  .app-section {
    width: 100%;
    margin-bottom: 2rem;
  }

  .details-section {
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    padding: 4rem 1.5rem;
    width: 100%;
  }

  .details-container {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  .details-container h2 {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .details-container > p {
    color: var(--text-secondary);
    max-width: 800px;
    margin: 0 auto 3rem auto;
    font-size: 1.05rem;
  }

  .details-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    text-align: left;
  }

  .detail-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-color);
    padding: 2rem;
    border-radius: 12px;
  }

  .detail-card h3 {
    margin-bottom: 1rem;
    font-size: 1.25rem;
  }

  .detail-card p {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 2.25rem;
    }

    .details-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
